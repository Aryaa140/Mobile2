<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scroll_gradient"
    tools:context=".HistoriStatusLibActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:theme="@style/ToolbarWhiteIcons"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@android:color/white"
        app:title="Histori Status Lib"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- RecyclerView untuk menampilkan histori -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHistori"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@+id/btnHapusSemua"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tombol Hapus Semua (Fixed di bagian bawah) - GUNAKAN BUTTON BIASA -->
    <Button
        android:id="@+id/btnHapusSemua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="HAPUS SEMUA HISTORI"
        android:textColor="@android:color/white"
        android:background="@color/red_error"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Belum ada histori perubahan status"
        android:textSize="16sp"
        android:textColor="@color/gray_medium"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerViewHistori"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewHistori"
        app:layout_constraintStart_toStartOf="@id/recyclerViewHistori"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewHistori"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerViewHistori"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewHistori"
        app:layout_constraintStart_toStartOf="@id/recyclerViewHistori"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewHistori"/>

</androidx.constraintlayout.widget.ConstraintLayout>